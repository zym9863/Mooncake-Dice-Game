{
  "name": "mooncake-dice-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:full": "concurrently \"pnpm dev:server\" \"pnpm dev:web\"",
    "build:web": "vue-tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "pnpm build:web && pnpm build:server",
    "start:server": "node server/dist/server/src/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "vue": "^3.5.25",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vue-tsc": "^3.1.5",
    "tsx": "^4.20.6"
  }
}
